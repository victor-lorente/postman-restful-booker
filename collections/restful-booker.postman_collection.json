        {
          "name": "Get all bookings",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response is a non-empty array\", () => {\n    const body = pm.response.json();\n    pm.expect(body).to.be.an(\"array\").that.is.not.empty;\n});\n\npm.test(\"Every item has a bookingid\", () => {\n    pm.response.json().forEach(booking => {\n        pm.expect(booking).to.have.property(\"bookingid\");\n    });\n});\n\npm.test(\"Response time is below 2000 ms\", () => {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});\n\npm.environment.set(\"existingBookingId\", pm.response.json()[0].bookingid);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get booking by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Booking has the expected fields\", () => {\n    const booking = pm.response.json();\n    pm.expect(booking).to.include.keys(\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\");\n    pm.expect(booking.totalprice).to.be.a(\"number\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
