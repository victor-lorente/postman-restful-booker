        {
          "name": "Create booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();\n\npm.test(\"Status code is 200\", () => {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Booking is created with an id\", () => {\n    pm.expect(body.bookingid).to.be.a(\"number\");\n    pm.environment.set(\"bookingId\", body.bookingid);\n});\n\npm.test(\"Booking data matches the request\", () => {\n    pm.expect(body.booking.firstname).to.eql(\"Victor\");\n    pm.expect(body.booking.totalprice).to.eql(150);\n    pm.expect(body.booking.bookingdates.checkin).to.eql(\"2026-12-01\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"firstname\": \"Victor\",\n    \"lastname\": \"Lorente\",\n    \"totalprice\": 150,\n    \"depositpaid\": true,\n    \"bookingdates\": {\n        \"checkin\": \"2026-12-01\",\n        \"checkout\": \"2026-12-05\"\n    },\n    \"additionalneeds\": \"Breakfast\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/booking",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "booking"
              ]
            }
